import pandas as pd
import requests, zipfile, os, io

url = 'https://archive.ics.uci.edu/static/public/186/wine+quality.zip'
folder = './wine_dataset'

r = requests.get(url, stream=True)
thezip = zipfile.ZipFile(io.BytesIO(r.content))
thezip.extractall(folder)

